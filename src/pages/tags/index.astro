---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';
import { buildTagIndex } from '../../utils/tags';
import { withBase } from '../../utils/url';

const posts = await getPublishedPosts();
const tags = buildTagIndex(posts);
---

<BaseLayout title="Tags" description="All topics on Titian's Notes">
  <div class="page-header">
    <h1 class="page-title">Tags</h1>
    <p class="page-intro">{tags.length} topics</p>
  </div>

  <ul class="tag-cloud">
    {
      tags.map((tag) => (
        <li>
          <a class="tag-link" href={withBase(`/tags/${tag.slug}/`)}>
            {tag.name}
          </a>{' '}
          <span class="tag-count">{tag.posts.length}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
